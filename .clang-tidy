# clang-tidy 18 (gate 6, ADR-0004 §1). Disabled checks and why:
# - cppcoreguidelines-avoid-magic-numbers, readability-magic-numbers: calendar code is full of
#   numbers the spec names (1901, 12, 32); a constant for each would hide them, not explain them.
# - cppcoreguidelines-pro-bounds-constant-array-index: tables are indexed after a range check
#   (ADR-0002 §3); gsl::at would check twice and add a dependency. Off in tests too.
# - modernize-use-trailing-return-type: docs/API.md uses leading return types.
# - misc-non-private-member-variables-in-classes: aggregates such as date_diff have public members
#   on purpose (docs/API.md).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  misc-*,
  -misc-non-private-member-variables-in-classes
WarningsAsErrors: '*'
HeaderFilterRegex: '(include|patro)/'
CheckOptions:
  # The NEPDATE_VERSION_* macros are API (docs/API.md), so they can't become constexpr variables.
  cppcoreguidelines-macro-usage.AllowedRegexp: '^NEPDATE_'
