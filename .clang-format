# clang-format 18 (gate 1, ADR-0004 §1).
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
AllowShortFunctionsOnASingleLine: Inline
# docs/API.md writes `char* first`, not LLVM's `char *first`.
PointerAlignment: Left
# Catalogue lines must stay on one line, or tools/check_catalog.cmake can't find the row id.
# clang-tidy suppressions stay attached to their line, or they stop working.
CommentPragmas: '^ cs-(deviation|n/a):|NOLINT'
